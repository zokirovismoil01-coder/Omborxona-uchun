[
  {"text": "Stoktil — ombor va savdo nazorati.", "from": 0.0, "to": 2.365, "at": 0.55},
  {"text": "Omborda nima qoldi?", "from": 2.73, "to": 3.925, "at": 4.1},
  {"text": "Diler nima oldi?", "from": 4.295, "to": 5.445, "at": 5.42},
  {"text": "Ertaga nima kerak?", "from": 5.735, "to": 6.91, "at": 6.78},
  {"text": "Barcha javoblar — bitta ilovada.", "from": 7.145, "to": 9.405, "at": 8.45},
  {"text": "Pin-kod bilan himoya. Har bir xodimga — o'z ruxsati.", "from": 9.605, "to": 13.275, "at": 12.25},
  {"text": "Bugungi savdo, cheklar va qaytganlar — bir qarashda.", "from": 13.42, "to": 16.865, "at": 16.55},
  {"text": "Haftalik grafik va tugayotgan mahsulotlar.", "from": 17.08, "to": 19.56, "at": 20.35},
  {"text": "Dilerni tanlaysiz — narxlar o'zi qo'yiladi.", "from": 19.885, "to": 22.76, "at": 24.35},
  {"text": "Sonini kiritasiz, idishlarni belgilaysiz.", "from": 22.945, "to": 25.665, "at": 27.35},
  {"text": "Va chek tayyor!", "from": 25.805, "to": 26.995, "at": 30.45},
  {"text": "Qaytgan mahsulot omborga kiradi.", "from": 27.2, "to": 29.155, "at": 33.35},
  {"text": "Muddati o'tgani esa — hisobdan chiqadi.", "from": 29.335, "to": 31.69, "at": 35.75},
  {"text": "Idishlar ham hisobda.", "from": 31.89, "to": 33.23, "at": 38.35},
  {"text": "Kirim, sanoq, hisobdan chiqarish — har birida mas'ul shaxs yoziladi.", "from": 33.4, "to": 37.825, "at": 40.25},
  {"text": "Kim, qachon, qancha — hammasi tarixda.", "from": 38.055, "to": 41.105, "at": 45.4},
  {"text": "Eng muhimi — ertangi buyurtmani o'zi hisoblaydi.", "from": 41.31, "to": 44.275, "at": 48.6},
  {"text": "Ertaga va indinga qancha kerakligini aytib beradi.", "from": 44.455, "to": 47.48, "at": 52.15},
  {"text": "Har bir diler bo'yicha hisobot: savdo, qaytgan, sof summa.", "from": 47.64, "to": 52.15, "at": 56.3},
  {"text": "Uni rasm qilib, bir tugmada yuborasiz.", "from": 52.34, "to": 54.56, "at": 60.95},
  {"text": "Barcha qurilmalar — bitta bazada. Internet uzilsa ham ishlaydi.", "from": 54.76, "to": 58.83, "at": 64.15},
  {"text": "Begona qurilmani darhol o'chirasiz.", "from": 59.075, "to": 61.3025, "at": 69.35},
  {"text": "Har bir o'zgarish — sababi bilan saqlanadi.", "from": 61.485, "to": 64.075, "at": 72.35},
  {"text": "Stoktil. Omboringiz — nazoratda!", "from": 64.265, "to": 67.11, "at": 76.35}
]

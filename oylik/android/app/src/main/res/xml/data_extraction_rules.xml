<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutli zaxira va yangi telefonga ko'chirishda ma'lumotlar saqlanadi -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
